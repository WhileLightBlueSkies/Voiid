3b:["$","div",null,{"children":[["$","h3",null,{"className":"page_limitTitle__Iiao5","children":"We know a share exists, who it is with, and when it ends."}],["$","p",null,{"className":"page_limitBody__NMgDw","children":"That is real metadata and it is ours. The relay additionally sees who sent a frame, an opaque share id, the list of recipients and the timing — the same class of metadata as a typing indicator. It never sees a coordinate."}]]}]
3c:["$","li","There is no “who viewed your location”, and no history.",{"className":"page_limit__C_zD7","children":[["$","span",null,{"className":"page_limitGlyph__229bD","aria-hidden":"true","children":["$","svg",null,{"className":"$undefined","style":"$undefined","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","role":"$undefined","aria-label":"$undefined","aria-hidden":true,"focusable":"false","children":"$b:props:children:0:0:props:children:1:props:children:0:props:children:3:props:children:1:props:children:0:props:children"}]}],["$","div",null,{"children":[["$","h3",null,{"className":"page_limitTitle__Iiao5","children":"There is no “who viewed your location”, and no history."}],["$","p",null,{"className":"page_limitBody__NMgDw","children":"View receipts would need a channel that reports your friends’ browsing back to them, so we did not build one. Neither are there geofences, arrival alerts or trails: Voiid keeps exactly one position per contact and overwrites it in place."}]]}]]}]
