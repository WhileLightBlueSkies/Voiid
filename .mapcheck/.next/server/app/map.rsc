29:["$","figcaption",null,{"className":"page_figCaption__tgKUy","children":"Every visibility session mints its own random 32-byte key on your phone and hands it to your audience inside an ordinary end-to-end encrypted message. The server never carries the key, only the sealed fixes it cannot open."}]
