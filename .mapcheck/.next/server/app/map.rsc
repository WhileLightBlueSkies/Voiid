40:{"metadata":[["$","title","0",{"children":"Map — Voiid"}],["$","meta","1",{"name":"description","content":"Voiid’s Map opens ghosted: you appear to no one until you name individual people. Positions are end-to-end encrypted, ghosting mints a fresh key, and our servers store that a share exists — never where you are."}],["$","meta","2",{"name":"application-name","content":"Voiid"}],["$","meta","3",{"name":"robots","content":"index, follow"}],["$","meta","4",{"property":"og:title","content":"Voiid — one encrypted app for chat, calls, the map, clips and games"}],["$","meta","5",{"property":"og:description","content":"End-to-end encrypted messages, calls, location and moments. Clips and games are public, and we say so. Built in India, for the world."}],["$","meta","6",{"property":"og:site_name","content":"Voiid"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"Voiid — one encrypted app for chat, calls, the map, clips and games"}],["$","meta","10",{"name":"twitter:description","content":"End-to-end encrypted messages, calls, location and moments. Clips and games are public, and we say so. Built in India, for the world."}]],"error":null,"digest":"$undefined"}
