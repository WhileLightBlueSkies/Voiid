{
  "name": "voiid",
  "private": true,
  "version": "0.1.0",
  "description": "VOIID — privacy-first, E2E-encrypted messaging super-app (monorepo).",
  "workspaces": [
    "backend/*",
    "packages/*",
    "apps/web",
    "apps/admin-web",
    "apps/web-client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @voiid/api",
    "dev:ws": "npm run dev -w @voiid/websocket",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node tools/check-ludo-assets.js"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}
