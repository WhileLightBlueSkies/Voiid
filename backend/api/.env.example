# VOIID API — calls backend env template (TURN / ICE for WebRTC).
# Copy the vars you need into the repo-root .env (gitignored). NEVER commit real secrets.
#
# Calls are E2E: the server issues TURN credentials and relays signaling only — it
# never sees call media or SRTP keys. TURN is optional in dev (STUN-only fallback).

# --- Calls: STUN (public reflexive-address discovery; safe to expose) ---
# Comma-separated. Defaults to Google's public STUN if unset.
VOIID_STUN_URLS=stun:stun.l.google.com:19302

# --- Calls: self-hosted coturn (REST ephemeral-credential scheme) ---
# Comma-separated TURN URLs advertised to clients, e.g.:
#   turn:turn.voiid.app:3478?transport=udp,turns:turn.voiid.app:5349?transport=tcp
VOIID_TURN_URLS=
# coturn `static-auth-secret` (matches `use-auth-secret` on the coturn box). SECRET.
# Credentials are HMAC-SHA1(secret, "<unixExpiry>:<userId>"), per-user + time-limited.
VOIID_TURN_STATIC_AUTH_SECRET=
# Credential lifetime in seconds (default 3600 = 1 hour).
VOIID_TURN_TTL_SECONDS=3600

# --- Calls: Cloudflare TURN (managed alternative; preferred when BOTH are set) ---
# If these are present the API asks Cloudflare to mint credentials instead of coturn.
VOIID_TURN_CLOUDFLARE_KEY_ID=
VOIID_TURN_CLOUDFLARE_API_TOKEN=

# --- Calls: iOS PushKit / VoIP push (call RINGING only) ---
# A normal alert push cannot reliably wake a KILLED iOS app in time to ring via
# CallKit. A VoIP push can. It needs its own APNs topic (`<bundle-id>.voip`) and
# usually its own signing key, which is why these are separate from APNS_*.
# The payload stays content-free: routing ids only, never SDP/keys/media.
#
# Each of these falls back to the matching APNS_* var when unset, so a deployment
# that reuses one key across both topics only needs VOIID_APNS_VOIP_TOPIC.
#
# APNs topic for VoIP pushes. Defaults to "<APNS_BUNDLE_ID>.voip".
# NOTE: sending a voip push to the plain bundle id is rejected (TopicDisallowed).
VOIID_APNS_VOIP_TOPIC=
# Key id of the VoIP .p8 (falls back to APNS_KEY_ID).
VOIID_APNS_VOIP_KEY_ID=
# Apple team id (falls back to APNS_TEAM_ID).
VOIID_APNS_VOIP_TEAM_ID=
# The VoIP signing key: EITHER a path to the .p8 file...
VOIID_APNS_VOIP_KEY_PATH=
# ...OR the PEM inline (falls back to APNS_KEY_PATH / APNS_KEY_P8). SECRET.
VOIID_APNS_VOIP_P8=

# --- Group calls: LiveKit SFU (see docs/LIVEKIT_SETUP.md) ---
# Group calls need an SFU; mesh WebRTC collapses past ~4 participants. Media stays
# E2E encrypted with a key derived on-device (GroupSession.callKeys) — the SFU
# forwards frames it cannot decrypt. The API only mints join tokens.
# If any of the three below is unset, POST /calls/group/token returns 503
# { livekit_configured: false } instead of failing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
# Signs the join JWTs (HS256). SECRET.
LIVEKIT_API_SECRET=
# Join-token lifetime in seconds (default 21600 = 6 hours).
LIVEKIT_TOKEN_TTL_SECONDS=21600

# --- GIF search (Tenor) ---
# Powers the GIF picker in the composer, proxied through GET /gifs/* so the key never ships
# inside the app (where anyone can extract it from an IPA/APK) and users' searches don't reach
# Google carrying their IP.
#
# TENOR, NOT GIPHY: Tenor is free with no hard public cap and needs no attribution badge;
# GIPHY's free tier rate-limits at ~1k/day and mandates a "Powered By GIPHY" mark on screen.
# Get a key at https://console.cloud.google.com (enable the Tenor API).
#
# UNSET IS SAFE: /gifs/* returns { gifs: [], configured: false } and the picker says "GIFs
# aren't set up" rather than spinning. Nothing else in the app is affected.
TENOR_API_KEY=
# Stable per-integration identifier Tenor uses to separate our traffic. Any short string.
TENOR_CLIENT_KEY=voiid
