// Release.xcconfig
//
// Endpoints for RELEASE builds (TestFlight, App Store, and any archive).
//
// Release points at PRODUCTION: https://api.voiid.app, the production server. An archive made
// straight from Xcode for TestFlight therefore needs no settings and cannot reach the dev box
// by omission. (The live values are the Release build settings in project.pbxproj; this file is
// the reference copy.)
//
// A different backend — e.g. a staging server — can be supplied per archive:
//
//     xcodebuild archive -scheme Voiid \
//       VOIID_API_BASE_URL=https://api-staging.voiid.app \
//       VOIID_WS_URL=wss://api-staging.voiid.app/ws
//
// A Release build aimed at the dev box (api-dev.voiid.app) refuses to launch: see
// `developmentHosts` in APIClient.swift. Debug builds stay on the dev box — Debug.xcconfig.

VOIID_API_BASE_URL = https://api.voiid.app
VOIID_WS_URL = wss://api.voiid.app/ws
