<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon FOREGROUND — the Voiid mark in PEACOCK TEAL, flat.
  Scaled to ~52dp inside the 108dp canvas so it clears the mask crop on every launcher: only
  the inner 66dp is guaranteed visible, and circle masks bite hardest at the corners.

  Flat #13828C, matching res/drawable/voiid_logomark.xml and the iOS/web marks. The lime
  original shaded the back bar with a five-stop gradient; that depth cue is dropped
  deliberately — and at launcher size it was the first thing lost to downscaling anyway.

  ── ALSO THE MONOCHROME LAYER ───────────────────────────────────────────────────
  mipmap-anydpi-v26/ic_launcher.xml points <monochrome> at this same drawable. Android tints
  monochrome icons itself, ignoring fillColor, so the flat fill is if anything more correct
  there than a gradient was: themed icons only ever see the SHAPE.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#13828C" android:pathData="M59.40,65.53 A6.41,6.41 0 0 1 48.30,71.94 L31.20,42.32 A6.41,6.41 0 0 1 42.30,35.91 Z" />
    <path android:fillColor="#13828C" android:pathData="M51.36,60.47 A5.99,5.99 0 0 1 61.73,66.46 L58.67,71.76 A5.99,5.99 0 0 1 48.30,65.78 Z" />
    <path android:fillColor="#13828C" android:pathData="M65.51,35.91 A6.41,6.41 0 0 1 76.61,42.32 L59.49,71.97 A6.41,6.41 0 0 1 48.39,65.56 Z" />
</vector>
