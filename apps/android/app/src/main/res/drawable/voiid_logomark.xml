            <gradient
                android:type="linear"
                android:startX="49.17" android:startY="74.32"
                android:endX="9.39" android:endY="5.42">
                <item android:offset="0.00" android:color="#457512" />
                <item android:offset="0.26" android:color="#82A334" />
                <item android:offset="0.51" android:color="#AAD91E" />
                <item android:offset="0.77" android:color="#A6E00A" />
                <item android:offset="1.00" android:color="#70AC05" />
