<?xml version="1.0" encoding="utf-8"?>
<!--
  Voiid mark — PEACOCK TEAL, back bar SHADED. Three rounded bars forming the V.

  ── WHY THE BACK BAR IS A GRADIENT ─────────────────────────────────────────────────
  The shading is the depth cue, not decoration. Ramping the back bar from #0F464A at its far
  end to full brand #13828C where the bars meet is what makes it read as ONE STROKE PASSING
  BEHIND the other, rather than three flat bars crossing at a point. Stops are the same two
  iOS uses in Assets.xcassets/VoiidLogoMark.imageset/voiid-logomark.svg, sampled there off
  AppIcon-1024.png along the bar's axis.

  This file was FLAT until now and iOS was not, so the same mark read as three crossing bars
  on one platform and as a woven V on the other. The lime original had the depth; the teal
  rebrand dropped it on Android and web and restored it only on iOS.

  ── THE GRADIENT'S ANGLE IS THE BAR'S OWN AXIS ─────────────────────────────────────
  iOS gets this from gradientUnits="userSpaceOnUse" with the ramp running down the rect's
  pre-rotation y-axis, which after rotate(150) points along the bar. Android <gradient> has
  no such space, so the start/end points below are that axis resolved into the same absolute
  viewport coordinates the paths already use.

  Rotations are BAKED IN: Android vector <path> has no transform attribute, so these path data
  are the SVG's rotated rects resolved into absolute coordinates. Do not "simplify" them back
  into rects; they will not match the iOS and web marks if you do.

  ── ONE COLOUR, ONE PLACE ──────────────────────────────────────────────────────────
  #13828C is VoiidColor.primary and VoiidColor.accent. Changing the brand colour means
  changing it here, in the iOS imageset, and in apps/web/components/Logomark.tsx.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="88dp"
    android:height="80dp"
    android:viewportWidth="88"
    android:viewportHeight="80">
    <!-- The BACK bar: dark at its far end (bottom-left), full brand where the bars meet. -->
    <path android:pathData="M53.14,59.52 A10.84,10.84 0 0 1 34.36,70.36 L5.42,20.23 A10.84,10.84 0 0 1 24.20,9.39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="29.28" android:startY="64.94"
                android:endX="14.81" android:endY="39.87">
                <item android:offset="0" android:color="#0F464A" />
                <item android:offset="1" android:color="#13828C" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#13828C" android:pathData="M39.54,50.96 A10.13,10.13 0 0 1 57.08,61.09 L51.90,70.06 A10.13,10.13 0 0 1 34.36,59.93 Z" />
    <path android:fillColor="#13828C" android:pathData="M63.48,9.39 A10.84,10.84 0 0 1 82.26,20.23 L53.29,70.41 A10.84,10.84 0 0 1 34.51,59.57 Z" />
</vector>
