<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon BACKGROUND. Voiid Black.

  This was the stock Android Studio green (#3DDC84) with the default bugdroid on top — the
  brand had never reached the launcher at all. Flat black is deliberate: the mark itself carries
  the lime (see ic_launcher_foreground.xml), and an adaptive icon's background is masked to
  whatever shape the launcher chooses, so anything drawn near its edges is cropped
  unpredictably.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0B0B0B"
        android:pathData="M0,0h108v108h-108z" />
</vector>
