      takes over — a white flash on every cold start in dark mode.
    -->
    <color name="voiid_primary">#B59BE0</color>       <!-- aubergine, lifted for dark -->
    <color name="voiid_background">#0D0B14</color>    <!-- near-black aubergine -->
    <color name="voiid_field_fill">#171320</color>
</resources>
