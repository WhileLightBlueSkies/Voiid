<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      PEACOCK TEAL brand tokens, LIGHT. Mirrors ui/theme/Color.kt (VoiidPalette) — keep the two
      in step; these exist because the launch window is drawn by the platform before Compose is
      alive, so it cannot read the Kotlin tokens.

      MIGRATED FROM ELECTRIC LIME. The old file carried a note that voiid_primary was INK here
      rather than the brand colour, because #C6FF00 measures 1.19:1 on white and would have
      been invisible. That no longer applies: #13828C is 4.87:1 on the light ground, so the
      brand colour IS the spine in both themes now.
    -->
    <color name="voiid_primary">#13828C</color>       <!-- Peacock teal -->
    <color name="voiid_accent">#13828C</color>        <!-- same hex; accent is a fill -->
    <color name="voiid_background">#F6F8F8</color>    <!-- light variant ground -->
    <color name="voiid_field_fill">#EDF1F1</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
