<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- iOS LaunchBackground: #F6F8F8 in light, #14191C in dark (values-night). -->
    <color name="voiid_launch_background">#F6F8F8</color>
    <bool name="voiid_launch_light_bars">true</bool>
    <style name="Theme.Voiid.Launch.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/voiid_launch_background</item>
        <item name="android:statusBarColor">@color/voiid_launch_background</item>
        <item name="android:navigationBarColor">@color/voiid_launch_background</item>
        <item name="android:windowLightStatusBar">@bool/voiid_launch_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/voiid_launch_light_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Voiid.Launch" parent="Theme.Voiid.Launch.Base" />
</resources>
