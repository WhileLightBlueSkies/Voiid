33:{"metadata":[["$","title","0",{"children":"Clips — Voiid"}],["$","meta","1",{"name":"description","content":"Short public video, creator profiles and follows. Clips are not end-to-end encrypted and we explain exactly why — a broadcast has no recipient set to encrypt to. Following someone grants no right to message them."}],["$","meta","2",{"name":"application-name","content":"Voiid"}],["$","meta","3",{"name":"robots","content":"index, follow"}],["$","meta","4",{"property":"og:title","content":"Voiid — one encrypted app for chat, calls, the map, clips and games"}],["$","meta","5",{"property":"og:description","content":"End-to-end encrypted messages, calls, location and moments. Clips and games are public, and we say so. Built in India, for the world."}],["$","meta","6",{"property":"og:site_name","content":"Voiid"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"Voiid — one encrypted app for chat, calls, the map, clips and games"}],["$","meta","10",{"name":"twitter:description","content":"End-to-end encrypted messages, calls, location and moments. Clips and games are public, and we say so. Built in India, for the world."}]],"error":null,"digest":"$undefined"}
