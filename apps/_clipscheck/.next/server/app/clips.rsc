12:["$","section",null,{"id":"feeds","style":{"--hue":"var(--hue-clips)","--hue-wash":"color-mix(in srgb, var(--hue-clips) 12%, transparent)"},"aria-labelledby":"feeds-heading","className":"Section_section__rXxcK","children":["$","div",null,{"className":"Section_measure__9z54r Section_default__Duexr","children":[["$","header",null,{"className":"Section_header__D1nq4","children":[["$","span",null,{"className":"eyebrow","children":"Watching"}],["$","h2",null,{"id":"feeds-heading","className":"Section_title__3e7VL","children":"Two feeds, both in plain time order."}],["$","p",null,{"className":"Section_lede__rmpij","children":"Explore is every live clip, newest first. Following is a separate query over the creators you follow — a different source, not a filter laid over Explore."}]]}],["$","div",null,{"className":"Section_split__958Ms Section_splitReverse__0_iub","children":[["$","div",null,{"className":"Section_splitCopy__ZnhZU","children":["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"There is no ranking model behind either grid. Nothing scores a clip, nothing scores you, and nothing decides what deserves the top of your screen — the order is the order things were posted in. Paging is by timestamp, so a clip posted while you are scrolling cannot make a tile repeat or vanish."}],["$","p",null,{"children":"We do record that you watched something: one row per clip per viewer, written after about two seconds of watching, which is what makes a view count once however many times you rewatch it. It is not used to sort your feed. Say the two sentences together, because both are true."}],["$","p",null,{"children":"A creator profile carries a handle, display name, bio, link, avatar and three counts. There is no endpoint that lists somebody’s followers — you can see the numbers, and you can see your own Following feed, but the roster itself is not exposed to anyone."}]]}]}],["$","div",null,{"className":"Section_splitAside__PazP3","children":["$","div",null,{"style":{"--hue":"var(--hue-clips)","--hue-wash":"color-mix(in srgb, var(--hue-clips) 12%, transparent)"},"className":"PhoneMockup_stage__EMmlW PhoneMockup_md__fGr1x PhoneMockup_tilt-left__SD_kg","role":"img","aria-label":"Illustration of a creator profile in Voiid: handle, avatar, clip, follower and following counts, a bio, a Follow button, and a grid of that creator's covers.","aria-hidden":"$undefined","children":[["$","span",null,{"className":"PhoneMockup_glow__Yo141","aria-hidden":"true"}],["$","div",null,{"className":"PhoneMockup_device__Tj34g","children":[["$","span",null,{"className":"PhoneMockup_buttonVolumeUp__F7uIZ","aria-hidden":"true"}],["$","span",null,{"className":"PhoneMockup_buttonVolumeDown__STSxs","aria-hidden":"true"}],["$","span",null,{"className":"PhoneMockup_buttonPower__Whhx5","aria-hidden":"true"}],["$","div",null,{"className":"PhoneMockup_screen__VIpIw","children":[["$","div",null,{"className":"PhoneMockup_statusBar__RyeJH","aria-hidden":"true","children":[["$","span",null,{"className":"PhoneMockup_clock__qk2OT","children":"9:41"}],["$","span",null,{"className":"PhoneMockup_island__0AM7y"}],["$","span",null,{"className":"PhoneMockup_indicators__NVgWB","children":[["$","span",null,{"className":"PhoneMockup_signal__hV2di"}],["$","span",null,{"className":"PhoneMockup_battery__3wIdA"}]]}]]}],["$","div",null,{"className":"PhoneMockup_content__PBCaz","children":[["$","div",null,{"className":"PhoneMockup_appBar__o8J_R","children":[["$","span",null,{"className":"PhoneMockup_back__1PPKN","aria-hidden":"true"}],["$","span",null,{"className":"PhoneMockup_appBarText__5zRuv","children":[["$","span",null,{"className":"PhoneMockup_appBarTitle__4TE73","children":"@ananya"}],["$","span",null,{"className":"PhoneMockup_appBarSubtitle__981_R","children":"Creator profile"}]]}],null]}],["$","div",null,{"className":"page_creator__zr6Kp","children":[["$","div",null,{"className":"page_creatorTop__EoJns","children":[["$","span",null,{"className":"PhoneMockup