13:["$","section",null,{"id":"follow","style":{"--hue":"var(--hue-clips)","--hue-wash":"color-mix(in srgb, var(--hue-clips) 12%, transparent)"},"aria-labelledby":"follow-heading","className":"Section_section__rXxcK Section_inset__hE67S","children":["$","div",null,{"className":"Section_measure__9z54r Section_default__Duexr","children":[["$","header",null,{"className":"Section_header__D1nq4","children":[["$","span",null,{"className":"eyebrow","children":"The rule that matters most"}],["$","h2",null,{"id":"follow-heading","className":"Section_title__3e7VL","children":"A follow is not a messaging right."}],["$","p",null,{"className":"Section_lede__rmpij","children":"Following is one-way and needs nobody’s approval, because it grants exactly one thing: seeing content that was already public. A creator with a million followers has a million people who can watch their clips and zero extra people who can message them."}]]}],[["$","div",null,{"className":"page_doorsWrap__WUHrs","children":[["$","h3",null,{"className":"page_doorsTitle__j05Zq","children":"The only three ways a conversation opens"}],["$","ol",null,{"className":"page_doors__im95Z","children":[["$","li",null,{"className":"page_door__j_CiB","children":[["$","span",null,{"className":"page_doorNum__X5rbx","aria-hidden":"true","children":"1"}],["$","span",null,{"className":"page_doorBody__DNusb","children":[["$","strong",null,{"children":"You are both in each other’s contacts."}],"The chat opens directly."]}]]}],["$","li",null,{"className":"page_door__j_CiB","children":[["$","span",null,{"className":"page_doorNum__X5rbx","aria-hidden":"true","children":"2"}],["$","span",null,{"className":"page_doorBody__DNusb","children":[["$","strong",null,{"children":"They have you saved, but you do not have them."}],"It arrives as a request you accept or decline. Having somebody’s number is not by itself permission to reach them."]}]]}],["$","li",null,{"className":"page_door__j_CiB","children":[["$","span",null,{"className":"page_doorNum__X5rbx","aria-hidden":"true","children":"3"}],["$","span",null,{"className":"page_doorBody__DNusb","children":[["$","strong",null,{"children":"They looked you up by @username and had your 6-digit PIN."}],"Also a request. The PIN is something you hand out yourself."]}]]}]]}],["$","p",null,{"className":"page_doorShut__A5ntv","children":[["$","span",null,{"className":"page_doorShutIcon__BoxLK","aria-hidden":"true","children":["$","svg",null,{"className":"$undefined","style":"$undefined","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","role":"$undefined","aria-label":"$undefined","aria-hidden":true,"focusable":"false","children":"$10:props:children:props:children:1:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children"}]}],["$","span",null,{"className":"page_doorBody__DNusb","children":[["$","strong",null,{"children":"Following someone is not a fourth way."}],"The follow graph is a separate table from the one that decides who may message you, and nothing in the messaging code reads it. Any future code that consults your followers to authorise a conversation is a bug, not a feature."]}]]}]]}],["$","div",null,{"className":"page_handles___pJBY","children":[["$","h3",null,{"className":"page_handlesTitle__OJHnq","children":"Your creator handle is not your chat username"}],["$","p",null,{"children":"A chat username is half of a credential — it is only useful to someone who also has your PIN. A creator handle is meant to be printed on a poster. Making them the same value would mean going public as a creator silently publishes your messaging lookup key, so they are separate fields with separate meanings."}],["$","p",null,{"children":["They do share one pool of names, though: taking ",["$","code",null,{"children":"@ananya"}]," as a creator makes it unavailable as a chat username and the other way round, since one name meaning two different people in one app is how impersonation starts. A handful of names — ",["$","code",null,{"children":"admin"}],", ",["$","code",null,{"children":"support"}],", ",["$","code",null,{"children":"voiid"}]," ","and the rest — belong to nobody. Handles are lowercase, 3 to 20 characters, and changeable once every 30 days; links to your old one keep resolving to the new one until somebody else legitimately takes it."]}]]}]]]}]}]
14:["$","section",null,{"id":"deleting","style":{"--hue":"var(--hue-clips)","--hue-wash":"color-mix(in srgb, var(--hue-clips) 12%, transparent)"},"aria-labelledby":"deleting-heading","className":"Section_section__rXxcK","children":["$","div",null,{"className":"Section_measure__9z54r Section_narrow__J_05T","children":[["$","header",null,{"className":"Section_header__D1nq4","children":[["$","span",null,{"className":"eyebrow","children":"Taking one down"}],["$","h2",null,{"id":"deleting-heading","className":"Section_title__3e7VL","children":"Deleting a clip is not a security operation."}],["$","p",null,{"className":"Section_lede__rmpij","children":"It removes the clip from every feed and deletes the stored files, including all three qualities. It cannot reach the people who already watched it."}]]}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":"The row itself survives as a tombstone rather than being erased outright, so counts and open comment lists on other people’s phones do not vanish mid-scroll — but the video, the cover and every rendition are removed from storage, and a lifecycle rule on the bucket is the backstop if that call fails."}],["$","p",null,{"children":"The honest part is the second sentence: a clip was never encrypted, so anyone who watched it could have kept it, and deleting it cannot change that. The confirmation in the app says exactly this. It is the difference between unpublishing and unsaying, and only one of those is something software can do."}],["$","p",null,{"children":"Our own takedowns work the same way and are reversible: a removed clip is hidden rather than destroyed, the reason is recorded, and every moderator action is written to an audit log that survives the moderator’s account. “Who removed this and why” has to have an answer, or moderation is something that happens to people rather than something anyone is accountable for."}]]}]]}]}]
15:["$","section",null,{"style":{"--hue":"var(--hue-clips)","--hue-wash":"color-mix(in srgb, var(--hue-clips) 12%, transparent)"},"className":"CTA_cta__TRDk7","children":["$","div",null,{"className":"CTA_panel__aDal0","children":[["$","span",null,{"className":"CTA_edge___2oAM","aria-hidden":"true"}],["$","span",null,{"className":"CTA_bloom__NuScp","aria-hidden":"true"}],["$","div",null,{"className":"CTA_body__fY5_O","children":[["$","h2",null,{"className":"CTA_title__3F73S","children":"One line, if you keep only one."}],["$","p",null,{"className":"CTA_lede__bhlj1","children":"Clips are public and our server reads them. Your messages, calls, location and moments are not, and it cannot. Following someone buys nobody a way into your inbox. All three of those sentences are load-bearing."}],["$","div",null,{"className":"CTA_actions__cox8N","children":["$","div",null,{"className":"Button_row__5Xz0T Button_rowCenter__Z6j69","children":[["$","$L5",null,{"className":"Button_btn__WOgGk Button_primary__zsboU Button_lg__JaqPh","href":"/privacy","children":[null,["$","span",null,{"children":"Read the privacy architecture"}],null]}],["$","$L5",null,{"className":"Button_btn__WOgGk Button_secondary__RufDp Button_lg__JaqPh","href":"/messaging","children":[null,["$","span",null,{"children":"How messaging is protected"}],null]}]]}]}],["$","p",null,{"className":"CTA_note__fSvuV","children":"iOS and Android builds are still in testing. Store links will appear on this site once they exist, and not before."}]]}]]}]}]
