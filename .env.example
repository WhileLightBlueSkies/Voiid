# VOIID — environment template. Copy to .env (gitignored). Separate values per env (dev/staging/prod).
# NEVER commit real secrets. In CI these come from GitHub Secrets (Section 7.7).

NODE_ENV=development

# --- API service ---
API_PORT=4000

# --- WebSocket service ---
WS_PORT=4001
# Relay frame budgets (R02). One budget counts EVERY frame on a socket, in frames and bytes,
# and is checked before any parse or Redis call — the per-type limits below it shape one
# behaviour each, while this bounds the socket as a whole. Defaults clear the sum of the
# legitimate maxima (games 1800/min + calls 600/min + location + typing) with headroom.
# VOIID_WS_MAX_FRAMES_PER_MIN=3000
# VOIID_WS_MAX_BYTES_PER_MIN=16777216
# Ceilings on the per-key limiter maps, which are keyed by client-supplied share/match ids.
# VOIID_WS_MAX_SHARE_KEYS=64
# VOIID_WS_MAX_MATCH_KEYS=64
# Sockets one account may hold on one relay instance. The OLDEST is closed when exceeded, so
# a reconnecting client always gets in and a stale socket is what gets cleaned up.
# VOIID_WS_MAX_SOCKETS_PER_USER=8

# --- Database (Supabase = Postgres host ONLY; not Supabase Auth, not Supabase Realtime) ---
# Use plain Postgres in critical paths so swapping host = connection-string change.
# Read by the API, the workers AND (since S03) the websocket relay, which verifies device
# sessions against it at connect time — the relay refuses to boot in production without it.
# The relay's pool is capped at WS_DB_POOL_MAX (default 2) to stay light on Supabase's pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiid

# --- Redis (presence, pub/sub, typing, rate-limit, cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth (OURS — Firebase only sends OTP SMS) ---
JWT_SECRET=change-me-in-every-env
JWT_EXPIRY=30d
# How long the credential from POST /auth/firebase lives. It can ONLY register a device
# (which trades it for a device-bound session), so it is deliberately short.
JWT_BOOTSTRAP_EXPIRY=1h
# S03 MIGRATION DEADLINE. Until this instant, credentials with no device session — every
# token issued before S03, plus any bootstrap token not yet traded in — keep working.
# From it, only a device-bound session is accepted and everything else must re-authenticate.
# Leave UNSET to keep the window open; set an ISO-8601 instant at least one JWT_EXPIRY after
# the release that ships session-aware clients. Both the API and the relay read this.
# VOIID_SESSION_CUTOFF=2026-11-01T00:00:00Z

# --- SMS / OTP provider (swappable interface: firebase | msg91 | twilio) ---
SMS_PROVIDER=firebase
FIREBASE_CONFIG=

# --- Firebase Admin (verifies OTP tokens AND sends FCM wake pushes) ---
# The service-account JSON (stringified) OR a path to the JSON file. Reused for both
# Phone-Auth token verification and content-free FCM data (wake) messages.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Push: content-free "wake" notifications (NO message content ever) ---
# FCM (Android) reuses FIREBASE_SERVICE_ACCOUNT(_PATH) above — no extra config.
# APNs (iOS): token-based .p8 auth key over HTTP/2. Provide the key inline (APNS_KEY_P8)
# or as a file path (APNS_KEY_PATH); the rest identify the key/team/app + environment.
APNS_KEY_PATH=            # path to the AuthKey_XXXX.p8 file
APNS_KEY_P8=             # OR the .p8 PEM contents inline (alternative to APNS_KEY_PATH)
APNS_KEY_ID=             # 10-char Key ID from the Apple Developer portal
APNS_TEAM_ID=            # 10-char Apple Developer Team ID
APNS_BUNDLE_ID=          # app bundle id, e.g. com.voiid.app (APNs topic)
APNS_ENV=production      # sandbox | production

# --- Media (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=voiid-media

# --- Ops ---
SENTRY_DSN=
